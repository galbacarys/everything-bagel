{
  "name": "everything-bagel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An opinionated agentic development workflow: a control room that owns the screen and drives pi as a subservient worker.",
  "license": "MIT",
  "bin": {
    "bagel": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "preview": "bun run scripts/render-preview.ts",
    "backlog": "bun run scripts/backlog.ts",
    "dispatch": "bun run scripts/dispatch.ts",
    "build": "bun build --compile --outfile dist/bagel src/main.ts",
    "stats": "bun run scripts/stats.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
